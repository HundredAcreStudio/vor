# Binaries
/bin/
/dist/
# Anchored — gitignore bare patterns match anywhere in the tree, which
# would also exclude the cmd/vor/ and cmd/vor-augment/ source
# directories. The leading slash limits the match to the repo root.
/vor
/vor-augment

# Test + coverage
*.test
*.out
coverage.txt

# Go work files (ignored by default but explicit)
go.work
go.work.sum

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local data
.vor/
*.db
*.db-journal
*.db-shm
*.db-wal

# Note: <repo>/CLAUDE.md is intentionally NOT ignored — it carries the
# vor-managed block plus the team's own instructions above the
# REPOWISE markers, and regeneration is idempotent (no timestamp churn),
# so it's meant to be committed.

# Env
.env
.env.local

# Build caches
.cache/
