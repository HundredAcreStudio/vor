# Binaries
/bin/
/dist/
# Anchored — gitignore bare patterns match anywhere in the tree, which
# would also exclude the cmd/repowise/ and cmd/repowise-augment/ source
# directories. The leading slash limits the match to the repo root.
/repowise
/repowise-augment

# Test + coverage
*.test
*.out
coverage.txt

# Go work files (ignored by default but explicit)
go.work
go.work.sum

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local data
.repowise/
*.db
*.db-journal
*.db-shm
*.db-wal

# Env
.env
.env.local

# Build caches
.cache/
